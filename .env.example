# Local invocation of Lambda handlers (e.g. via `aws lambda invoke` or unit tests).
# Production values are wired by Terraform at deploy time.

AWS_REGION=ap-northeast-1
CONTENT_BUCKET=sandbox-hosting-content-xxxxxxxx
META_TABLE=sandbox-hosting-meta
PUBLIC_BASE_URL=https://xxxxxxxxxx.cloudfront.net

UPLOAD_TOKEN_PARAM=/sandbox-hosting/UPLOAD_TOKEN
SLACK_SIGNING_SECRET_PARAM=/sandbox-hosting/SLACK_SIGNING_SECRET
SLACK_BOT_TOKEN_PARAM=/sandbox-hosting/SLACK_BOT_TOKEN
