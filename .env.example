# Vercel Blob auto-injected when the store is linked
BLOB_READ_WRITE_TOKEN=

# Comma-separated CIDRs / IPv4 / IPv6 allowed to view published sites
# Example: 203.0.113.0/24,2001:db8::/32,198.51.100.42
ALLOWED_IPS=

# Bearer token used by Claude Code skill / CLI uploads
UPLOAD_TOKEN=

# Slack slash command verification secret
SLACK_SIGNING_SECRET=

# Vercel Cron protection token (matches X-Vercel-Cron header in prod, or sent via Bearer)
CRON_SECRET=

# Public base URL — used to build the returned URL in upload responses
PUBLIC_BASE_URL=https://sandbox.example.com
