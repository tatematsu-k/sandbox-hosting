project    = "sandbox-hosting"
aws_region = "ap-northeast-1"

allowed_ips = [
  # "203.0.113.0/24",
  # "198.51.100.42",
  # "2001:db8::/32",
]

# Leave empty on first apply, then re-apply with the CloudFront domain
# (or a custom domain) once you know it.
public_base_url = ""

# Optional — leave empty to skip SNS topic & email subscription.
alarm_email = ""
