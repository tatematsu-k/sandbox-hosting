{
  "name": "sandbox-hosting",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-lambda.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:tf": "terraform -chdir=terraform fmt -check -recursive",
    "tf:init": "terraform -chdir=terraform init",
    "tf:plan": "terraform -chdir=terraform plan",
    "tf:apply": "terraform -chdir=terraform apply"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1085.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-ssm": "^3.1085.0",
    "@aws-sdk/lib-dynamodb": "^3.1085.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "ipaddr.js": "^2.2.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^20.19.43",
    "@types/unzipper": "^0.10.10",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
